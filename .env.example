# Configurações do Aplicativo
APP_NAME="Aplicativo de Visitas Técnicas de Segurança do Trabalho"
APP_ENV=development
DEBUG=True

# Configurações de Banco de Dados
DATABASE_URL=sqlite:///storage/database.sqlite3

# Segurança
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# Identificação
# O login é feito apenas pela seleção do nome, sem senha ou código.
# Toda sessão começa na tela de login. O perfil ADM é lido do cadastro do
# usuário selecionado; este modelo exige ambiente controlado, sem exposição
# pública.

# Captura automática de temperatura (CHANGE 03)
# Opcional: sem esta chave, o sistema usa a Open-Meteo (gratuita) como fallback.
# Obtenha uma chave em https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Backend Xano (veja xano/README.md)
# URL do API group, sem barra no final:
XANO_BASE_URL=https://SEU-INSTANCIA.xano.io/api:acnnorte
# Conta de serviço usada pelo app para sincronizar clientes, visitas e fotos.
# Como o login do app é só pelo nome (sem senha), é por esta conta que os dados
# chegam ao Xano. Crie um usuário ativo no Xano só para isso. No Streamlit Cloud,
# coloque estas chaves em Settings > Secrets. Nunca versione os valores reais.
XANO_SERVICE_EMAIL=
XANO_SERVICE_PASSWORD=
# Opcional: token fixo de reserva (expira em 24 h no Xano; prefira a conta acima).
XANO_AUTH_TOKEN=
