# Configurações do Aplicativo
APP_NAME="Aplicativo de Visitas Técnicas de Segurança do Trabalho"
APP_ENV=development
DEBUG=True

# Configurações de Banco de Dados
DATABASE_URL=sqlite:///storage/database.sqlite3

# Segurança
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# Identificação e autorização
# O login comum é feito pela seleção do nome, sem senha.
# Toda Sessão começa na tela de login.
#
# O perfil ADM exige, além da seleção do usuário administrador, um código
# separado configurado somente no servidor. Sem este valor o login ADM é
# bloqueado. Não versione o código real em produção.
ACN_ADMIN_ACCESS_CODE=

# Captura automática de temperatura (CHANGE 03)
# Opcional: sem esta chave, o sistema usa a Open-Meteo (gratuita) como fallback.
# Obtenha uma chave em https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Backend Xano (veja xano/README.md)
# URL do API group, sem barra no final:
XANO_BASE_URL=https://SEU-INSTANCIA.xano.io/api:acnnorte
# Token opcional para chamadas administrativas ao Xano; não versione o token real.
XANO_AUTH_TOKEN=
